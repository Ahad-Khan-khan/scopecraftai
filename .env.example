# ===================================================================
# ScopeCraft AI Quotation Platform - Environment Configuration
# ===================================================================

# 1. n8n Production Webhook Endpoint
# URL of your active n8n webhook (from Stage 3 quotation_workflow.json)
NEXT_PUBLIC_N8N_WEBHOOK_URL=http://localhost:5678/webhook/generate-quotation

# 2. Server-side API Keys (Optional if set in n8n; passed as secure headers from Next.js proxy route)
GEMINI_API_KEY=AIzaSy...your-gemini-api-key
TAVILY_API_KEY=tvly-...your-tavily-api-key

# 3. Base Hourly Agency Rate (Default: $50 USD/hr)
DEFAULT_HOURLY_RATE_USD=50

# 4. Exchange Rate (USD to PKR)
USD_TO_PKR_RATE=278.50
